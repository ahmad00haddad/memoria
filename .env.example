# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must NEVER be committed.

# --- Supabase (client + server) ---
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PROJECT_ID="YOUR-PROJECT-ID"
SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"

# Vite-exposed (browser) copies — safe to expose, anon key only.
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-ID"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"

# --- Server-only secrets (set in Cloudflare / Lovable, NOT in the browser) ---
# Service-role key — full DB access. Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=""

# Resend transactional email (use a VERIFIED custom domain in production).
RESEND_API_KEY=""
# Sender address on a verified domain, e.g. "EliteCapture <noreply@your-domain.com>"
EMAIL_FROM=""

# Cloudflare Turnstile — anti-abuse on public forms (Phase 1).
TURNSTILE_SECRET_KEY=""
VITE_TURNSTILE_SITE_KEY=""

# WhatsApp Cloud API (optional — Phase 3).
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_ID=""
