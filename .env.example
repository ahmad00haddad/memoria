# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must NEVER be committed.

# --- Supabase (client + server) ---
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PROJECT_ID="YOUR-PROJECT-ID"
SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"

# Vite-exposed (browser) copies — safe to expose, anon key only.
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-ID"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"

# --- Server-only secrets (set in Cloudflare / Lovable, NOT in the browser) ---
# Service-role key — full DB access. Server-only. Never expose to the client.
# يُستخدم لتجاوز RLS (Row Level Security) في وظائف الخادم الحساسة.
SUPABASE_SERVICE_ROLE_KEY=""

# Resend transactional email (use a VERIFIED custom domain in production).
# مفتاح API الخاص بخدمة Resend لإرسال رسائل البريد الإلكتروني.
RESEND_API_KEY=""

# البريد الإلكتروني المُرسِل الافتراضي (مثال: "Memoria <noreply@memoria.jo>")
EMAIL_FROM="Memoria <onboarding@resend.dev>"

# Cloudflare Turnstile — anti-abuse on public forms (Phase 1).
TURNSTILE_SECRET_KEY=""
VITE_TURNSTILE_SITE_KEY=""

# WhatsApp Cloud API (optional — env-gated, no-op safe when unset).
# Meta Business → WhatsApp → API. Used for booking/deposit confirmations.
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_ID=""

# --- Public app URL (absolute links in emails / payment redirects) ---
# مثال الإنتاج: "https://your-domain.com". يُستخدم في روابط البريد وإعادة توجيه الدفع.
PUBLIC_APP_URL="https://royal-lens-flow.lovable.app"

# --- Payments (Priority 1 — online deposit checkout + subscription billing) ---
# طبقة تجريد قابلة للتبديل (payments.server.ts). كلها env-gated: عند تركها فارغة
# تعمل المنصّة كـ no-op آمن ويبقى مسار CliQ اليدوي فعّالاً.
#
# المزوّد المُفعّل: "stripe" (مرجعي) — أو "hyperpay" لاحقاً (الأنسب للأردن، يدعم JOD).
PAYMENT_PROVIDER="stripe"
# عملة الدفع (ISO 4217). ملاحظة: Stripe لا يدعم حسابات تجّار JOD في الأردن —
# استخدم HyperPay للإنتاج بالدينار. اتركها USD للتجربة مع Stripe.
PAYMENT_CURRENCY="USD"

# Stripe (مرجعي) — مفاتيح خادمية فقط، لا تُعرَّض للمتصفح إطلاقاً.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# HyperPay (للأردن — هيكل جاهز للتنفيذ لاحقاً في payments.server.ts).
# HYPERPAY_ACCESS_TOKEN=""
# HYPERPAY_ENTITY_ID=""
# HYPERPAY_WEBHOOK_SECRET=""
